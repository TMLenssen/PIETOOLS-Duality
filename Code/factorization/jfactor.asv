function [Psi_p,Psi_d] = jfactor(Pi_ss,nz,nw)
Pi_ss = minreal(ss(Pi));

%% Stable/anti-stable separation
[Pi_stab, Pi_anti] = stabsep(Pi_ss);
Pi_stab = minreal(Pi_stab);

A = Pi_stab.A;
B = Pi_stab.B;
C = Pi_stab.C;
D = Pi_stab.D;

%% D = W.'*J*W
[W,J,lam] = congruence_factor_D(D);

%% Solve ARE:
% A.'X + X*A - (X*B + C.')*D^(-1)*(B.'*X + C) = 0
Q = zeros(size(A,1));
[X,K,L,info] = icare(A,B,Q,D,C.');

%% J-spectral factor
Cpsi = J*(W'\(B.'*X + C));
Psi_p = minreal(ss(A,B,Cpsi,W));


J = [zeros(nz,nw),eye(nz); -eye(nw), zeros(nw,nz)];
Dd = (J'*Psi_p.D'*J)^{-1};
Psi_d = ss(Psi_p.A' - Psi_p.C'*Dd)
end

function [W,J,lam] = congruence_factor_D(D,tol)
% Find W,J such that D = W.'*J*W
% D must be real symmetric and nonsingular.

    if nargin < 2
        tol = 1e-10;
    end

    D = (D + D.')/2;   % remove numerical asymmetry

    [V,Lam] = eig(D);
    lam = diag(Lam);

    pos = find(lam > tol);
    neg = find(lam < -tol);
    zer = find(abs(lam) <= tol);

    if ~isempty(zer)
        error('D is numerically singular; zero eigenvalues found.');
    end

    % Sort: positive eigenvalues first, negative eigenvalues second
    idx = [pos; neg];
    lam = lam(idx);
    V = V(:,idx);

    p = numel(pos);
    q = numel(neg);

    J = blkdiag(eye(p), -eye(q));

    S = diag(sqrt(abs(lam)));

    W = S * V.';

    % Verification
    fprintf('||D - W.''*J*W|| = %.3e\n', norm(D - W.'*J*W, 'fro'));
end