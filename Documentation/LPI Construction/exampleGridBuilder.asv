clear; clc; close all; clear stateNameGenerator
echo on

path_to_PIE = 'C:\Program Files\MATLAB\PIETOOLS\PIETOOLS';
addpath(genpath(path_to_PIE))
addpath(genpath("C:\Program Files\Mosek\11.0\toolbox\r2019b"))
addpath(genpath("C:\Program Files\MATLAB\R2023a\toolbox\symbolic"));
pvar s t;
echo off;

a = 0;
b= 1;

x1 = pde_var('state',1); x2 = pde_var('state',1); x3 = pde_var(1,s,[a,b]); x4 = pde_var(1,s,[a,b]);
zd1 = pde_var('output', 1, s, [a,b]); wd1 = pde_var('input', 1, s, [a,b]);
w = pde_var('input',1);
z1 = pde_var('output',1); z2 = pde_var('output',1);
y1 = pde_var('sense',1); y2 = pde_var('sense',1);
tau = 0.5;%

% %---------------------------------------------------------------------% %
% % Example DDE from  K. Gu, J. Chen, and V. L. Kharitonov, Stability of Time-Delay Systems example 5.11:
% % DDE             x_{tt}(t) = 0.1*x_{t}(t) -2*x(t) - x(t-tau)
% % Conversion to ODE-PDE:
% % ODE             x1_{t}(t) = x_2(t)
% %                 x2_{t}(t) = -2*x1(t) + 0.1*x2(t) + x3(t,1)
% % PDE             x3_{t}(t,s) = -tau^-1*x3_s(t,s)
% % with SC         x3(t,0) = x1(t);
% %
% % Then we construct the LFR
% % ODE             x1_{t}(t) = x_2(t)
% %                 x2_{t}(t) = -2*x1(t) + 0.1*x2(t) + x3(t,1)
% % PDE             x3_{t}(t,s) = -tau^-1*x3_{s}(t,s) + wd
% %                 zd(t,s) = x3_{s}(t,s)
% %                 with wd = \delta zd, \delta \in [-\gamma^-1, \gamma^-1]
% % with SC         x3(t,0) = x1(t);
% %
% % then            \tau_{max} = (\tau^-1 + \gamma^-1), \tau_{min} =
% (\tau^-1 - \gamma^-1)
% %---------------------------------------------------------------------% %
PDE = [diff(x1,t) == x2;
    diff(x2,t) == -2*x1 + 0.1*x2 + subs(x3,s,b) + 0.1*w;
    diff(x3,t) == -tau^-1*diff(x3,s,1) + wd1;
    zd1 == diff(x3,s,1);
    z1 == int(x3,s,[a,b]);
    subs(x3,s,a) == x1]


PIE = convert(PDE, 'pie');
data = struct();

data.misc = PIE.misc;
data.dim = PIE.dim;
data.dom = PIE.dom;
data.vars = PIE.vars;
data.T = PIE.T;
data.A = PIE.A; data.Bw = PIE.B1(:,1); data.Bd = PIE.B1(:,2);
data.Cd = PIE.C1(2,:); data.Dd = PIE.D11(2,2); data.Ddw = PIE.D11(2,1);
data.Cz = PIE.C1(1,:); data.Dzd = PIE.D11(1,2); data.Dzw = PIE.D11(1,1);

% 2. Convert it to a upie
uPIE = upie(data);

dim1 = ioDimensions();
% Add some variables
dim1.add("x", uPIE.nx);
dim1.add("wd", uPIE.nwd);

A = gridBuilder(uPIE, dim1, dim1);
A.add(uPIE.A,1,1);

dim2 = ioDimensions();
% Add some variables
dim2.add("wd", uPIE.nwd);
dim2.add("x", uPIE.nx);
dim2.add("v", uPIE.nz);
B = gridBuilder(uPIE, dim2, dim2);
B.add(uPIE.A,2,2);

[A, B] = gridBuilder.alignGrids(uPIE,A,B)



%%
test_gridBuilder_basic(uPIE)
% Create ioDimensions instance
inputDimensions = ioDimensions();
% Add some variables
inputDimensions.add('x', uPIE.nx);
inputDimensions.add('wd', uPIE.nwd);
inputDimensions.add('w', uPIE.nw);

% Create ioDimensions instance
outputDimensions = ioDimensions();
% Add some variables
outputDimensions.add('x', uPIE.nx);
outputDimensions.add('zd', uPIE.nzd);
outputDimensions.add('w', uPIE.nz);

% Display current list
inputDimensions.display();
outputDimensions.display();

builder = gridBuilder(uPIE, outputDimensions, inputDimensions);
compare1 = [uPIE.A,  uPIE.Bd,  uPIE.Bw;
            uPIE.Cd, uPIE.Dd,  uPIE.Ddw;
            uPIE.Cz, uPIE.Dzd, uPIE.Dzw];
builder.add(uPIE.A,1,1);
builder.add(uPIE.Bd,1,2);
builder.add(uPIE.Bw,1,3);
builder.add(uPIE.Cd,2,1);
builder.add(uPIE.Dd,2,2);
builder.add(uPIE.Ddw,2,3);
builder.add(uPIE.Cz,3,1);
builder.add(uPIE.Dzd,3,2);
builder.add(uPIE.Dzw,3,3);
compare2 = builder.getGrid; 


% -------------------------------------------------------------------- %
% Multiplication example (name-based alignment with permuted dimensions)
% Build a permutation operator that swaps x and wd by name
permOutDims = ioDimensions();
permOutDims.add('wd', uPIE.nwd);
permOutDims.add('x', uPIE.nx);
permOutDims.add('w', uPIE.nw);

permBuilder = gridBuilder(uPIE, inputDimensions, permOutDims);
permBuilder.add(eyePI(uPIE, uPIE.nwd), 2, 1); % wd <- wd
permBuilder.add(eyePI(uPIE, uPIE.nx), 1, 2);  % x  <- x
permBuilder.add(eyePI(uPIE, uPIE.nw), 3, 3);  % w  <- w

try
productBuilder = permBuilder*builder;
catch
    error("input dimensions of permBuilder do not match output dimensions of builder")
end
comparePerm = [uPIE.Bd,  uPIE.A,   uPIE.Bw;
               uPIE.Dd,  uPIE.Cd,  uPIE.Ddw;
               uPIE.Dzd, uPIE.Cz,  uPIE.Dzw]
check = comparePerm == productBuilder.getGrid
productBuilder.inputDim
productBuilder.outputDim


% -------------------------------------------------------------------- %
% Addition example (merging of input and output dimensions)
% Create ioDimensions instance
dimensions1 = ioDimensions();
% Add some variables
dimensions1.add('x', uPIE.nx);
dimensions1.add('wd', uPIE.nwd);

dimensions2 = ioDimensions();
% Add some variables
dimensions2.add('wd', uPIE.nwd);
dimensions2.add('x', uPIE.nx);

builder1 = gridBuilder(uPIE, dimensions1, dimensions1);
builder1.add(uPIE.A,1,1);

builder2 = gridBuilder(uPIE, dimensions2, dimensions2);
builder2.add(uPIE.A,2,2);

summed = (builder1 + builder2);
summed.inputDim
summed.outputDim
compare1 = summed.getGrid;
builder3 = gridBuilder(uPIE, dimensions1, dimensions1);
builder3.add(2*uPIE.A,1,1);
compare2 = builder3.getGrid;
compare1 == compare2

% -------------------------------------------------------------------- %
% Adjoint example
% Create ioDimensions instance
I = ioDimensions();
% Add some variables
I.add('x', uPIE.nx);
I.add('wd', uPIE.nwd);

O = ioDimensions();
O.add('x', uPIE.nx);
builder1 = gridBuilder(uPIE, O, I);
builder1.inputDim
ajdbuilder = builder1';
ajdbuilder.outputDim