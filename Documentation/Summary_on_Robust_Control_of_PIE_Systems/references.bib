@article{koserobust,
author = {Köse, I. E. and Scherer, C. W.},
title = {{Robust $\mathcal{L}_2$-gain feedforward control of uncertain systems using dynamic IQCs}},
journal = {International Journal of Robust and Nonlinear Control},
volume = {19},
number = {11},
pages = {1224-1247},
keywords = {feedforward control, uncertain systems, integral quadratic constraints},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/rnc.1374},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/rnc.1374},
abstract = {Abstract We consider the problem of robust $\mathcal{L}_2$-gain disturbance feedforward control for uncertain systems described in the standard LFT form. We use integral quadratic constraints (IQCs) for describing the uncertainty blocks in the system. For technical reasons related to the feedforward problem, throughout the paper, we work with the duals of the constraints involved in robustness analysis using IQCs. We obtain a convex solution to the problem using a state-space characterization of nominal stability that we have developed recently. Specifically, our solution consists of LMI conditions for the existence of a feedforward controller that guarantees a given $\mathcal{L}_2$-gain for the closed-loop system. We demonstrate the effectiveness of using dynamic IQCs in robust feedforward design through a numerical example. Copyright \textcopyright{} 2008 John Wiley \& Sons, Ltd.},
year = {2009}
}

